# Copy to .env.local and fill in. Do NOT commit .env.local.

# ── Claude ────────────────────────────────────────────────────────────────
# Required: your Anthropic API key — https://console.anthropic.com/settings/keys
# Server-side only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Optional: model for the qualification chat.
# Default: claude-sonnet-5 (good multilingual quality, real-time price).
# Cheaper: claude-haiku-4-5   |   Higher quality: claude-opus-5
ANTHROPIC_MODEL=claude-sonnet-5

# ── Supabase ──────────────────────────────────────────────────────────────
# Public — safe in the browser (all access is gated by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — BYPASSES Row Level Security. Never prefix with NEXT_PUBLIC_
# and never read from client code.
SUPABASE_SERVICE_ROLE_KEY=

# Apply the schema with the Supabase CLI (`npx supabase db push`) or by running
# supabase/migrations/*.sql in the dashboard SQL editor.

# ── Follow-up scheduler (Phase G) ─────────────────────────────────────────
# Required to enable POST/GET /api/internal/follow-ups/run. Server-only,
# never NEXT_PUBLIC_. A platform cron (Vercel Cron, Supabase Cron, an
# external scheduler) calls that route with
#   Authorization: Bearer <FOLLOW_UP_CRON_SECRET>
# Generate one with:  openssl rand -hex 32
FOLLOW_UP_CRON_SECRET=

# Optional scheduler tuning (server-only). Defaults: 25 / 3 / 900000ms.
# FOLLOW_UP_BATCH_SIZE=25
# FOLLOW_UP_MAX_ATTEMPTS=3
# FOLLOW_UP_STUCK_PROCESSING_MS=900000

# ── WhatsApp (Meta Cloud API) — Phase H ──────────────────────────────────
# All server-only. Never NEXT_PUBLIC_. Never commit real values.
#
# Meta App secret — used to verify the X-Hub-Signature-256 on every webhook.
WHATSAPP_APP_SECRET=
# Your chosen token for the GET webhook verification handshake (Meta config).
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# 64 hex chars (32 bytes) — AES-256-GCM key for encrypting stored access
# tokens at rest.  Generate:  openssl rand -hex 32
WHATSAPP_TOKEN_ENCRYPTION_KEY=
# Optional: pin the Graph API version (default v23.0).
# WHATSAPP_GRAPH_API_VERSION=v23.0
# Set to 1 to use a no-network mock transport (local dev / E2E only).
# WHATSAPP_MOCK_TRANSPORT=0

# ── App URL (Phase J) ──────────────────────────────────────────────────────
# This deployment's own public origin, e.g. http://localhost:3000 in dev or
# https://app.example.com in production. Used ONLY to build absolute OAuth
# redirect URIs server-side — never trusts a request's Host header. Must
# exactly match the redirect URI registered in the Google Cloud Console.
APP_BASE_URL=http://localhost:3000

# ── Google Calendar integration — Phase J ─────────────────────────────────
# All server-only. Never NEXT_PUBLIC_. Never commit real values.
#
# From a Google Cloud project with the Calendar API enabled and an OAuth
# consent screen configured. Redirect URI to register:
#   <APP_BASE_URL>/api/integrations/google-calendar/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# 64 hex chars (32 bytes) — AES-256-GCM key for encrypting stored OAuth
# tokens at rest, and for signing the OAuth `state` (CSRF) parameter.
# Generate:  openssl rand -hex 32
CALENDAR_TOKEN_ENCRYPTION_KEY=
# Set to 1 to use a no-network mock transport (local dev / E2E only) — the
# OAuth token exchange and every Calendar API call return canned success
# responses instead of hitting Google.
# CALENDAR_MOCK_TRANSPORT=0

# ── Pilot hardening — public-chat rate limiting ───────────────────────────
# Server-only. The public qualification chat (/api/chat) and the embeddable
# widget are rate-limited per client IP and per organization to bound
# Anthropic spend against abuse. The limiter is DB-backed and FAILS OPEN — if
# the counter RPC errors, requests are allowed and the failure is reported via
# OPS_ALERT_WEBHOOK_URL. Defaults shown; uncomment to override.
# CHAT_RATE_LIMIT_PER_IP=20
# CHAT_RATE_WINDOW_SECONDS=60
# CHAT_RATE_LIMIT_PER_ORG_HOURLY=600

# ── Pilot hardening — operational alerting ────────────────────────────────
# Server-only. Optional. When set to an https:// URL, unhandled errors in
# background work (chat stream, WhatsApp webhook, follow-up scheduler) are
# POSTed as { "text": "..." } — compatible with a Slack or Discord incoming
# webhook. Secrets are redacted from the payload. Leave blank to log to
# stderr only (structured `[ops] {...}` lines).
OPS_ALERT_WEBHOOK_URL=

# ── Pilot hardening — restricted signup ───────────────────────────────────
# Server-only. Optional. When set to a non-blank value, public /signup is
# gated: a visitor must supply this exact invite code to create an account.
# Team invitations (dashboard → Settings → Team) bypass the gate via their
# signed invite link. Leave blank for open signup.
SIGNUP_INVITE_CODE=

# ── Pilot hardening — transactional email (SMTP) ──────────────────────────
# LeadFlow sends NO email itself. Password-reset and email-confirmation
# messages are sent by Supabase Auth. The Supabase built-in email service is
# rate-limited (a few messages/hour) and is NOT for production — configure a
# real SMTP provider before the pilot.
#
# This is Supabase project config, NOT app env. Set it in the Supabase
# dashboard (Authentication → Emails → SMTP Settings) or, for local dev, in
# supabase/config.toml under [auth.email.smtp]:
#   host, port, user, pass, admin_email, sender_name
# Also set Authentication → URL Configuration → Site URL and Redirect URLs to
# your APP_BASE_URL so reset/confirm links resolve. No provider secret belongs
# in this file.
