# Copy to .env.local and fill in.

# Required: your Anthropic API key (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=

# Optional: model for the qualification chat. Defaults to claude-opus-5.
# For a high-volume chat widget, claude-sonnet-5 or claude-haiku-4-5 is
# usually a better cost/latency trade-off.
# ANTHROPIC_MODEL=claude-sonnet-5
