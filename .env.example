# Copy to .env.local and fill in. Do NOT commit .env.local.

# Required: your Anthropic API key — https://console.anthropic.com/settings/keys
# Server-side only. Never prefix with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Optional: model for the qualification chat.
# Default: claude-sonnet-5 (good multilingual quality, real-time price).
# Cheaper: claude-haiku-4-5   |   Higher quality: claude-opus-5
ANTHROPIC_MODEL=claude-sonnet-5
